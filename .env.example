# Supabase PostgreSQL (Settings → Database → URI; use pooler for serverless)
# Example (transaction mode): postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Required for POST /api/sync-excel — send header x-api-key: <same value>
API_SECRET_KEY=

# Optional: if set, GET /api/data requires header x-api-key: <value>
# DASHBOARD_API_KEY=

# --- Optional: SharePoint Excel pull (legacy lib/dashboard-data.ts) ---
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# SHAREPOINT_HOSTNAME=
# SHAREPOINT_SITE_PATH=
# EXCEL_FILE_PATH=
# EXCEL_EXCLUDE_SHEETS=
